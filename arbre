e","filleul":"Melody"},{"parrain":"Maximus dit le Truand","filleul":"Lotus"},{"parrain":"Maximus dit le Truand","filleul":"Capitaine Jack"},{"parrain":"Apollo dit le Bon","filleul":"Achille le Saltimbanque"},{"parrain":"Apollo dit le Bon","filleul":"Fantasia"},{"parrain":"Apollo dit le Bon","filleul":"Molière dit le Philanthrope"},{"parrain":"L'Oxymore","filleul":"Lucrèce"},{"parrain":"Chaplin","filleul":"Lancelot"},{"parrain":"Chaplin","filleul":"Tempête"},{"parrain":"Astus du Brindacier","filleul":"Simba"},{"parrain":"Astus du Brindacier","filleul":"Dr Holmes"},{"parrain":"Astus du Brindacier","filleul":"Forest"},{"parrain":"Bolus","filleul":"Fantomette"},{"parrain":"Bolus","filleul":"Chihiro"},{"parrain":"L'Utopic","filleul":"Micromégas"},{"parrain":"L'Utopic","filleul":"Nyx"},{"parrain":"Petit Jean du Grand Gousier","filleul":"Cléopatre"},{"parrain":"Petit Jean du Grand Gousier","filleul":"Dexter"},{"parrain":"Tony Tony Chopper","filleul":"Hercule"},{"parrain":"Simba","filleul":"Nyx"},{"parrain":"Simba","filleul":"Fantomette"},{"parrain":"Dr Holmes","filleul":"Armstrong"},{"parrain":"Dr Holmes","filleul":"Hercule"},{"parrain":"Forest","filleul":"Django"},{"parrain":"Forest","filleul":"Fantasia"},{"parrain":"Forest","filleul":"Cléopatre"},{"parrain":"Forest","filleul":"Dexter"},{"parrain":"Melody","filleul":"Matoaka, intronisée La Louve"},{"parrain":"Melody","filleul":"Django"},{"parrain":"Achille le Saltimbanque","filleul":"Billy Jones l'Exalté"},{"parrain":"Maitre Renard","filleul":"Armstrong"},{"parrain":"Lancelot","filleul":"Pendragon"},{"parrain":"Capitaine Jack","filleul":"Frère Luron"},{"parrain":"Micromégas","filleul":"Nimbus"},{"parrain":"Tempête","filleul":"Bès le Furieux"},{"parrain":"Tempête","filleul":"Frère Luron"},{"parrain":"Fantomette","filleul":"Nimbus"},{"parrain":"Fantasia","filleul":"Pendragon"},{"parrain":"Fantasia","filleul":"Bès le Furieux"},{"parrain":"Armstrong","filleul":"Kiddo"},{"parrain":"Skippy (Lyon)","filleul":"Tonktonk"},{"parrain":"Guronzan","filleul":"Brindille"},{"parrain":"Greg","filleul":"Ibu"},{"parrain":"Rollerman","filleul":"Gollum"},{"parrain":"Manue","filleul":"KKTwist"},{"parrain":"Chagasse","filleul":"Bonnet M (Bichat)"},{"parrain":"Tutu (PO)","filleul":"Tonktonk"}]}</script>

<script>
(function(){
  "use strict";
  const raw = JSON.parse(document.getElementById('data').textContent);

  // ---- modèle ----
  const byName = new Map();
  raw.personnes.forEach(p=>{ if(!byName.has(p.nom)) byName.set(p.nom,{id:p.nom,gen0:p.gen}); });
  raw.liens.forEach(l=>{ [l.parrain,l.filleul].forEach(n=>{ if(!byName.has(n)) byName.set(n,{id:n}); }); });
  const nodes = [...byName.values()];
  const parents = new Map(), children = new Map();
  nodes.forEach(n=>{parents.set(n.id,[]);children.set(n.id,[]);});
  const links = raw.liens.map(l=>{
    children.get(l.parrain).push(l.filleul);
    parents.get(l.filleul).push(l.parrain);
    return {source:l.parrain, target:l.filleul};
  });

  // out-degree -> taille ; longest path depuis racines -> génération (gestion des cycles)
  nodes.forEach(n=>{ n.deg = children.get(n.id).length; });
  const gen = new Map(), state0 = new Map();
  function genOf(id){
    if(gen.has(id)) return gen.get(id);
    if(state0.get(id)===1) return 0;           // cycle : on coupe
    state0.set(id,1);
    let g=0;
    for(const p of parents.get(id)) g=Math.max(g, genOf(p)+1);
    state0.set(id,2); gen.set(id,g); return g;
  }
  nodes.forEach(n=> n.gen = genOf(n.id));
  const maxGen = d3.max(nodes,d=>d.gen);

  document.getElementById('stat-n').textContent = nodes.length;
  document.getElementById('stat-e').textContent = links.length;
  document.getElementById('stat-g').textContent = maxGen+1;

  // datalist
  const dl = document.getElementById('names');
  nodes.map(n=>n.id).sort((a,b)=>a.localeCompare(b,'fr')).forEach(id=>{
    const o=document.createElement('option'); o.value=id; dl.appendChild(o);
  });

  // ---- couleurs ----
  const genColor = d3.scaleSequential().domain([0,Math.max(1,maxGen)])
    .interpolator(d3.interpolateRgbBasis(['#7fb3d5','#76d7c4','#7dcea0','#f2d06b','#e59866','#cf6f4e','#a3232f']));
  const C = {sel:'#e7c15a', up:'#cf3b40', down:'#19a78e', dim:'#4a4150', dimLink:'rgba(120,108,132,.10)'};

  function renderLegend(){
    const L = document.getElementById('legend');
    if(colorMode==='gen'){
      let s='<div style="margin-bottom:4px;font-weight:600;color:var(--ink)">Génération (du plus ancien au plus récent)</div>';
      for(let g=0;g<=maxGen;g+=Math.ceil((maxGen+1)/6)) s+=`<span class="sw" style="background:${genColor(g)}"></span>G${g} &nbsp;`;
      s+='<div style="margin-top:6px">Taille du nœud = nombre de filleul·e·s.</div>';
      L.innerHTML=s;
    } else {
      L.innerHTML =
        `<span class="sw" style="background:${C.sel}"></span>personne sélectionnée<br>`+
        `<span class="sw" style="background:${C.up}"></span>parrains / marraines (remontée)<br>`+
        `<span class="sw" style="background:${C.down}"></span>filleul·e·s (descente)`;
    }
  }

  // ---- simulation ----
  const sim = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(links).id(d=>d.id).distance(34).strength(.32))
    .force('charge', d3.forceManyBody().strength(-46).distanceMax(360))
    .force('center', d3.forceCenter(0,0))
    .force('collide', d3.forceCollide().radius(d=>radius(d)+1.5))
    .alpha(1).alphaDecay(.022);

  function radius(d){ return 3 + Math.sqrt(d.deg)*1.7; }

  // ---- canvas ----
  const cv = document.getElementById('cv'), ctx = cv.getContext('2d');
  const main = cv.parentElement;
  let W=0,H=0,dpr=Math.min(2,window.devicePixelRatio||1);
  let transform = d3.zoomIdentity;
  function resize(){
    W=main.clientWidth; H=main.clientHeight;
    cv.width=W*dpr; cv.height=H*dpr; cv.style.width=W+'px'; cv.style.height=H+'px';
    draw();
  }
  window.addEventListener('resize', resize);

  // état focus
  let focusId=null, depth=2, colorMode='gen';
  let upSet=new Set(), downSet=new Set(), shown=null; // shown=null -> tout

  function computeFocus(){
    upSet=new Set(); downSet=new Set();
    if(!focusId){ shown=null; return; }
    // remontée (parrains)
    let layer=new Set([focusId]);
    for(let d=0; d<depth; d++){
      const next=new Set();
      layer.forEach(id=> parents.get(id).forEach(p=>{ if(p!==focusId && !upSet.has(p)){upSet.add(p); next.add(p);} }));
      layer=next; if(!layer.size) break;
    }
    // descente (filleul·e·s)
    layer=new Set([focusId]);
    for(let d=0; d<depth; d++){
      const next=new Set();
      layer.forEach(id=> children.get(id).forEach(c=>{ if(c!==focusId && !downSet.has(c)){downSet.add(c); next.add(c);} }));
      layer=next; if(!layer.size) break;
    }
    shown=new Set([focusId,...upSet,...downSet]);
  }

  function nodeColor(d){
    if(focusId){
      if(d.id===focusId) return C.sel;
      if(upSet.has(d.id)) return C.up;
      if(downSet.has(d.id)) return C.down;
      return C.dim;
    }
    return colorMode==='lineage' ? C.dim : genColor(d.gen);
  }
  function inFocus(id){ return !shown || shown.has(id); }

  function draw(){
    ctx.save();
    ctx.clearRect(0,0,cv.width,cv.height);
    ctx.scale(dpr,dpr);
    ctx.translate(W/2,H/2);
    ctx.translate(transform.x,transform.y);
    ctx.scale(transform.k,transform.k);

    // liens
    ctx.lineWidth=.7;
    for(const l of links){
      const lit = focusId ? (shown.has(l.source.id)&&shown.has(l.target.id)) : true;
      ctx.strokeStyle = lit ? (focusId?'rgba(207,59,64,.30)':'rgba(150,135,120,.20)') : C.dimLink;
      ctx.beginPath();
      ctx.moveTo(l.source.x,l.source.y);
      ctx.lineTo(l.target.x,l.target.y);
      ctx.stroke();
    }
    // nœuds
    for(const n of nodes){
      const lit=inFocus(n.id), r=radius(n);
      ctx.globalAlpha = lit?1:.5;
      ctx.beginPath(); ctx.arc(n.x,n.y,r,0,6.283);
      ctx.fillStyle=nodeColor(n); ctx.fill();
      if(n.id===focusId){ ctx.lineWidth=2.4; ctx.strokeStyle='#fff'; ctx.stroke(); }
      ctx.globalAlpha=1;
    }
    // étiquettes : focus -> sous-graphe ; sinon -> gros hubs + survol
    ctx.font='600 11px Inter, sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
    const labelIds = focusId ? shown : new Set(nodes.filter(n=>n.deg>=6).map(n=>n.id));
    if(transform.k>1.6 && !focusId) nodes.forEach(n=>labelIds.add(n.id)); // zoom : on montre tout
    for(const n of nodes){
      if(!labelIds.has(n.id)) continue;
      const r=radius(n);
      ctx.fillStyle='rgba(23,18,26,.78)';
      const w=ctx.measureText(n.id).width;
      ctx.fillRect(n.x-w/2-3, n.y+r+2, w+6, 13);
      ctx.fillStyle='#f4efe6'; ctx.fillText(n.id, n.x, n.y+r+9);
    }
    if(hover){
      const r=radius(hover);
      ctx.beginPath(); ctx.arc(hover.x,hover.y,r+3,0,6.283);
      ctx.lineWidth=2; ctx.strokeStyle=C.gold; ctx.stroke();
    }
    ctx.restore();
  }
  sim.on('tick', draw);

  // ---- interactions ----
  function toGraph(ev){
    const rect=cv.getBoundingClientRect();
    const px=ev.clientX-rect.left, py=ev.clientY-rect.top;
    return {x:(px-W/2-transform.x)/transform.k, y:(py-H/2-transform.y)/transform.k};
  }
  let hover=null;
  const tip=document.getElementById('tip');
  cv.addEventListener('mousemove',ev=>{
    const p=toGraph(ev);
    const n=sim.find(p.x,p.y,18);
    hover=n||null;
    if(n){
      tip.style.opacity=1;
      tip.style.left=(ev.clientX-main.getBoundingClientRect().left+14)+'px';
      tip.style.top=(ev.clientY-main.getBoundingClientRect().top+14)+'px';
      tip.innerHTML=`<b>${esc(n.id)}</b><div class="meta">Génération ${n.gen} · ${parents.get(n.id).length} parrain(s) · ${n.deg} filleul·e·s</div>`;
    } else { tip.style.opacity=0; }
    draw();
  });
  cv.addEventListener('mouseleave',()=>{hover=null;tip.style.opacity=0;draw();});

  const zoom=d3.zoom().scaleExtent([.15,6]).on('zoom',ev=>{
    // ne pas capter le drag de nœud
    if(ev.sourceEvent && ev.sourceEvent.type==='mousemove' && dragging) return;
    transform=ev.transform; draw();
  });
  d3.select(cv).call(zoom).on('dblclick.zoom',null);

  // drag de nœud
  let dragging=null;
  d3.select(cv).call(d3.drag()
    .container(cv)
    .subject(ev=>{ const p=toGraph(ev); return sim.find(p.x,p.y,18); })
    .on('start',ev=>{ if(!ev.subject)return; dragging=ev.subject; cv.classList.add('grabbing'); sim.alphaTarget(.25).restart(); ev.subject.fx=ev.subject.x; ev.subject.fy=ev.subject.y; })
    .on('drag',ev=>{ if(!dragging)return; const p=toGraph(ev); dragging.fx=p.x; dragging.fy=p.y; })
    .on('end',ev=>{ if(!dragging)return; cv.classList.remove('grabbing'); sim.alphaTarget(0); dragging=null; })
  );

  cv.addEventListener('click',ev=>{
    if(justDragged){justDragged=false;return;}
    const p=toGraph(ev); const n=sim.find(p.x,p.y,18);
    setFocus(n?n.id:null);
  });
  let justDragged=false;
  d3.select(cv).on('mousedown.flag',()=>{justDragged=false;});
  // marque un vrai drag pour ne pas déclencher le focus au relâché
  let downAt=null;
  cv.addEventListener('mousedown',ev=>downAt={x:ev.clientX,y:ev.clientY});
  cv.addEventListener('mouseup',ev=>{ if(downAt && Math.hypot(ev.clientX-downAt.x,ev.clientY-downAt.y)>4) justDragged=true; });

  // ---- focus + panneau ----
  function setFocus(id){
    focusId = id && byName.has(id) ? id : null;
    computeFocus(); renderFocusBox(); draw();
  }
  function chip(id){ return `<span class="chip" data-go="${esc(id)}">${esc(id)}</span>`; }
  function renderFocusBox(){
    const box=document.getElementById('focusbox');
    if(!focusId){
      box.innerHTML='<div class="ph">Clique sur un nœud (ou cherche un nom) pour isoler sa lignée : parrains au-dessus, filleul·e·s en dessous.</div>';
      return;
    }
    const ps=parents.get(focusId), cs=children.get(focusId);
    box.innerHTML =
      `<h2>${esc(focusId)}</h2>`+
      `<div class="lineage">`+
        `<div class="row"><span class="tag up">Parrains</span><span>${ps.length||'—'}</span></div>`+
        (ps.length?`<div class="chips">${ps.map(chip).join('')}</div>`:'')+
        `<div class="row" style="margin-top:6px"><span class="tag down">Filleul·e·s</span><span>${cs.length||'—'}</span></div>`+
        (cs.length?`<div class="chips">${cs.map(chip).join('')}</div>`:'')+
        `<div class="row" style="margin-top:8px"><span class="tag">Lignée visible</span><span>${shown.size} pers. · ${depth} gén.</span></div>`+
      `</div>`;
    box.querySelectorAll('[data-go]').forEach(el=>el.addEventListener('click',()=>{ const id=el.getAttribute('data-go'); document.getElementById('search').value=id; setFocus(id); centerOn(id); }));
  }

  function centerOn(id){
    const n=byName.get(id); if(!n||n.x==null)return;
    const k=Math.max(transform.k,1.3);
    transform=d3.zoomIdentity.scale(k).translate(-n.x,-n.y);
    d3.select(cv).call(zoom.transform, d3.zoomIdentity.translate(-n.x*k,-n.y*k).scale(k));
    draw();
  }

  // ---- contrôles ----
  document.getElementById('search').addEventListener('change',e=>{
    const v=e.target.value.trim();
    if(byName.has(v)){ setFocus(v); centerOn(v); } else if(!v){ setFocus(null); }
  });
  const depthSlider=document.getElementById('depth'), depthVal=document.getElementById('depth-val');
  depthSlider.addEventListener('input',e=>{ depth=+e.target.value; depthVal.textContent=depth+' gén.'; computeFocus(); renderFocusBox(); draw(); });

  document.querySelectorAll('#colormode button').forEach(b=>b.addEventListener('click',()=>{
    colorMode=b.dataset.mode;
    document.querySelectorAll('#colormode button').forEach(x=>x.setAttribute('aria-pressed', x===b));
    renderLegend(); draw();
  }));

  document.getElementById('reset').addEventListener('click',()=>{
    document.getElementById('search').value=''; setFocus(null); fit();
  });
  document.getElementById('zin').onclick =()=>d3.select(cv).transition().call(zoom.scaleBy,1.4);
  document.getElementById('zout').onclick=()=>d3.select(cv).transition().call(zoom.scaleBy,1/1.4);
  document.getElementById('zfit').onclick=fit;

  function fit(){
    const xs=nodes.map(n=>n.x), ys=nodes.map(n=>n.y);
    const minx=Math.min(...xs),maxx=Math.max(...xs),miny=Math.min(...ys),maxy=Math.max(...ys);
    const gw=maxx-minx||1, gh=maxy-miny||1;
    const k=Math.min(.9*W/gw, .9*H/gh, 2);
    const cx=(minx+maxx)/2, cy=(miny+maxy)/2;
    d3.select(cv).transition().duration(400).call(zoom.transform, d3.zoomIdentity.scale(k).translate(-cx,-cy));
  }

  // burger mobile
  document.getElementById('burger').onclick=()=>document.getElementById('panel').classList.toggle('open');

  function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}

  renderLegend();
  resize();
  // recadrage initial quand la simu s'est posée
  sim.on('end',()=>{});
  setTimeout(fit, 900);
})();
</script>
</body>
